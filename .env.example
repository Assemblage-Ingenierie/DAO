# ── Variables d'env Vite — Phase 4 Supabase ───────────────────────────────
#
# Toutes les variables exposées au code client DOIVENT être préfixées
# VITE_ (sinon Vite les ignore). Ces 2 valeurs sont récupérables depuis
# le dashboard Supabase : https://supabase.com/dashboard/project/<ref>/settings/api
#
# - VITE_SUPABASE_URL  : URL publique du projet Supabase (forme https://<ref>.supabase.co)
# - VITE_SUPABASE_KEY  : clé publishable (nouveau format sb_publishable_*) OU
#                        clé anon legacy (JWT). RLS fait la sécurité, donc
#                        ces clés sont safe d'exposer côté client.
#
# Copier ce fichier en .env.local (gitignored) et remplir les valeurs.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
